.card{background:#1e293b;border:1px solid #2d3a52;border-radius:14px;padding:22px}
.card-label{color:#94a3b8;font-size:13px}.card-num{font-size:28px;font-weight:800;margin-top:10px;word-break:break-word}.card-sub{color:#64748b;font-size:12px;margin-top:4px}
.box{background:#1e293b;border:1px solid #2d3a52;border-radius:14px;padding:22px;margin-bottom:16px}
table{width:100%;border-collapse:collapse;font-size:13px}
th{color:#94a3b8;text-align:left;padding:12px 8px;border-bottom:1px solid #334155;font-weight:500}
td{padding:12px 8px;border-bottom:1px solid #1e293b}
input,select,textarea{width:100%;padding:11px;border-radius:10px;background:#0f172a;color:#fff;border:1px solid #334155;margin-top:6px}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.7);display:none;place-items:center;z-index:1000;padding:12px}
.modal-box{background:#1e293b;border-radius:16px;padding:22px;width:92%;max-width:520px;max-height:92vh;overflow-y:auto}
.icon-box{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:16px}
.hamburger{display:none;background:#1e293b;border:1px solid #334155;color:#fff;font-size:22px;padding:6px 12px;border-radius:10px;cursor:pointer}
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:90}
.overlay.show{display:block}
.history-row{display:flex;justify-content:space-between;align-items:center;background:#0f172a;padding:14px;border-radius:10px;margin-top:8px;flex-wrap:wrap;gap:10px}
@media(max-width:900px){
  body{flex-direction:column}
  .hamburger{display:block}
  .sidebar{position:fixed;left:-280px;top:0;bottom:0;z-index:99;transition:left .3s;box-shadow:20px 0 40px rgba(0,0,0,.5);height:100dvh}
  .sidebar.open{left:0}
  .main{padding:14px;width:100%}
  .cards{grid-template-columns:1fr 1fr}
  .header{flex-direction:column}
  .header .no-print{display:flex;width:100%}
  .header .no-print .btn{flex:1}
}
@media(max-width:520px){
  .cards{grid-template-columns:1fr}
  .card,.box{padding:14px}
  .card-num{font-size:24px}
  .header h1{font-size:22px !important}
  .header .no-print{flex-direction:column}
  .history-row{flex-direction:column;align-items:flex-start}
  table{display:block;overflow-x:auto;white-space:nowrap}
}
@media print{ .sidebar,.no-print,.hamburger,.overlay{display:none!important} body{background:#fff;color:#000} .main{padding:0} .box,.card{background:#fff;color:#000;border:1px solid #ccc} }
</style>
