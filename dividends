<div class="main">
<div class="topbar"><div><button class="hamburger" onclick="toggleMenu()">☰</button></div><div class="icons"><span onclick="location.href='settings.html'">🔧</span><span style="position:relative" onclick="location.href='loans.html'">🔔<span id="topBellCount" style="position:absolute;top:-8px;right:-8px;background:#7f1d1d;font-size:10px;padding:2px 5px;border-radius:10px;display:none">0</span></span></div></div>

<div class="header"><div><h1 style="font-size:28px;font-weight:800">Dividends</h1><p style="color:#94a3b8;font-size:13px;margin-top:4px">Distribute profits to shareholders</p></div><div style="display:flex;gap:8px;flex-wrap:wrap" class="no-print"><button class="btn" onclick="window.print()">📄 Export PDF</button><button class="btn" onclick="showEconomic()">👥 Economic Participation</button><button class="btn btn-green" onclick="openDistribute()">💰 Distribute Dividends</button></div></div>

<div class="cards">
<div class="card"><div style="display:flex;gap:10px;align-items:center"><span class="icon-box" style="background:rgba(34,197,94,.15)">📊</span><span class="card-label">Total Shares Outstanding</span></div><div class="card-num" id="totalSharesOut">204</div><div class="card-sub" id="totalSharesValue">Value: LSL 408,000 • 1 Share = LSL 2,000</div></div>
<div class="card"><div style="display:flex;gap:10px;align-items:center"><span class="icon-box" style="background:rgba(59,130,246,.15)">👥</span><span class="card-label">Shareholders</span></div><div class="card-num" id="shareholdersOut">204</div><div class="card-sub" id="shareholdersSub">Members with at least 1 share</div></div>
<div class="card"><div style="display:flex;gap:10px;align-items:center"><span class="icon-box" style="background:rgba(234,179,8,.15)">💰</span><span class="card-label">Distributions Made</span></div><div class="card-num" id="distCountOut">0</div><div class="card-sub" id="distTotalOut">Total Paid: LSL 0.00</div></div>
</div>

<div id="economicBox" class="box" style="display:none"><div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px"><div><h3>👥 Economic Participation</h3><p style="color:#94a3b8;font-size:13px;margin-top:4px">Who owns what % of P.E. SACCOS LTD — based on shares</p></div><button class="btn no-print" onclick="document.getElementById('economicBox').style.display='none'">Hide</button></div>
<div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap" class="no-print"><input id="econSearch" placeholder="🔍 Search member..." oninput="renderEconomic()" style="flex:1;min-width:180px"><select id="econSort" onchange="renderEconomic()" style="max-width:200px"><option value="shares-desc">Most shares first</option><option value="shares-asc">Fewest shares first</option><option value="name">Name A-Z</option></select></div>
<div style="overflow-x:auto;margin-top:10px"><table><thead><tr><th>#</th><th>Member</th><th>Shares</th><th>Share Value</th><th>% of SACCO</th><th>Dividend if LSL <span id="econProfitLabel">10,000</span> distributed</th></tr></thead><tbody id="economicBody"></tbody></table></div></div>

<div class="box"><h3>Distribution History</h3><p style="color:#94a3b8;font-size:13px;margin-top:4px">Past dividend distributions</p>
<div id="historyList" style="margin-top:14px"></div>
<div id="emptyHistory" style="color:#94a3b8;text-align:center;padding:30px 0">No distributions yet.</div>
</div>

<div class="box"><h3>How Dividends work</h3><div style="color:#94a3b8;font-size:13px;line-height:1.8;margin-top:6px">
- <b style="color:#fff">1 Share = LSL 2,000</b> — Member with 2 shares owns LSL 4,000 of SACCO<br>
- <b style="color:#fff">Per Share Dividend = Total Profit ÷ Total Shares</b> — e.g. Profit LSL 20,400 ÷ 204 Shares = <b style="color:#fff">LSL 100 per share</b><br>
- <b style="color:#fff">Member Dividend = Shares × Per Share</b> — e.g. 2 shares × 100 = <b style="color:#fff">LSL 200</b><br>
- Dividend is added to member's Savings as <i>Dividend</i> transaction, so Savings total increases.<br>
- <b style="color:#fff">Example:</b> If you distribute <b style="color:#fff">LSL 10,000</b> today, each share gets <b style="color:#fff" id="examplePerShare">LSL 49.02</b>
</div></div>
</div>

<div id="distModal" class="modal"><div class="modal-box">
<div style="display:flex;justify-content:space-between;align-items:center"><h3>💰 Distribute Dividends</h3><span style="cursor:pointer;font-size:20px" onclick="closeDist()">×</span></div>
<p style="color:#94a3b8;font-size:13px;margin-top:6px">Profit will be shared by shares. Every shareholder gets the same amount per share.</p>
<label>Total Profit to Distribute (LSL) *</label><input id="profitInput" type="number" value="10000" oninput="updateDistPreview()">
<label>Distribution Date</label><input id="distDate" type="date">
<label>Note / Year</label><input id="distNote" placeholder="e.g. 2026 Annual Dividends">
<div id="distPreview" style="background:#0f172a;padding:14px;border-radius:10px;font-size:13px;line-height:1.8;margin-top:12px"></div>
<div style="max-height:200px;overflow-y:auto;margin-top:10px" id="distPreviewList"></div>
<div style="display:flex;gap:10px;margin-top:14px"><button class="btn btn-green" style="flex:1" onclick="confirmDistribute()">✅ Confirm & Distribute</button><button class="btn" style="flex:1" onclick="closeDist()">Cancel</button></div>
</div></div>

<div id="viewModal" class="modal"><div class="modal-box"><div style="display:flex;justify-content:space-between;align-items:center"><h3 id="viewTitle">Distribution</h3><span style="cursor:pointer;font-size:20px" onclick="closeView()">×</span></div><div id="viewBody" style="margin-top:12px"></div><button class="btn" style="margin-top:12px;width:100%" onclick="closeView()">Close</button></div></div>

<script>
function toggleMenu(){ document.getElementById('sidebar').classList.toggle('open'); document.getElementById('overlay').classList.toggle('show'); }
if(localStorage.getItem('pe_role')!=='admin'){ location.href='/index.html'; }
let members=[];
function fmt(n){ return 'LSL '+Number(n||0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function cleanName(v){ if(!v) return ''; let s=String(typeof v==='string'?v:(v.name||v.fullName||'')); if(s.includes('[object')||s.includes('HTMLParagraph')) return ''; return s; }
function getDists(){ try{ return JSON.parse(localStorage.getItem('dividendDistributions')||'[]'); }catch(e){ return []; } }
function setDists(d){ localStorage.setItem('dividendDistributions', JSON.stringify(d)); }
async function load(){
  try{ let r=await fetch('/api/members'); let d=await r.json(); members=Array.isArray(d)?d:(d.members||[]); }catch(e){ members=[]; }
  renderTop(); renderHistory(); updateBadges();
}
function shareCount(m){ return Number(m.shares||m.totalShares||m.shareCount||0); }
function renderTop(){
  let totalShares=members.reduce((s,m)=>s+shareCount(m),0);
  let holders=members.filter(m=>shareCount(m)>0);
  let dists=getDists();
  let totalPaid=dists.reduce((s,d)=>s+Number(d.totalProfit||0),0);
  document.getElementById('totalSharesOut').innerText=totalShares;
  document.getElementById('totalSharesValue').innerText='Value: '+fmt(totalShares*2000)+' • 1 Share = LSL 2,000';
  document.getElementById('shareholdersOut').innerText=holders.length;
  document.getElementById('shareholdersSub').innerText='Members with at least 1 share • Total members: '+members.length;
  document.getElementById('distCountOut').innerText=dists.length;
  document.getElementById('distTotalOut').innerText='Total Paid: '+fmt(totalPaid);
  document.getElementById('examplePerShare').innerText= totalShares ? fmt(10000/totalShares) : 'LSL 0';
  document.getElementById('econProfitLabel').innerText='10,000';
}
function renderHistory(){
  let dists=getDists().slice().reverse();
  let el=document.getElementById('historyList');
  document.getElementById('emptyHistory').style.display=dists.length?'none':'block';
  if(!dists.length){ el.innerHTML=''; return; }
  el.innerHTML=dists.map((d,i)=>{
    let realIdx=getDists().length-1 - i;
    return `<div class="history-row"><div><b>${d.note||'Dividend Distribution'}</b> <span style="color:#64748b;font-size:12px">• ${new Date(d.date).toLocaleDateString('en-GB')}</span><div style="color:#94a3b8;font-size:13px;margin-top:4px">Total: <b style="color:#22c55e">${fmt(d.totalProfit)}</b> • Per Share: <b>${fmt(d.perShare)}</b> • Members Paid: <b>${d.membersPaid}</b> • Total Shares: ${d.totalShares}</div></div><div style="display:flex;gap:6px"><button class="btn" onclick="viewDist(${realIdx})">View Members</button><button class="btn" style="color:#ef4444" onclick="deleteDist(${realIdx})">🗑️</button></div></div>`;
  }).join('');
}
function viewDist(idx){
  let d=getDists()[idx]; if(!d) return;
  document.getElementById('viewTitle').innerText=(d.note||'Distribution')+' — '+new Date(d.date).toLocaleDateString('en-GB');
  let rows=(d.breakdown||[]).slice().sort((a,b)=>b.dividend-a.dividend).slice(0,50);
  document.getElementById('viewBody').innerHTML=`<div style="color:#94a3b8;font-size:13px">Total Profit: <b style="color:#fff">${fmt(d.totalProfit)}</b> • Per Share: <b style="color:#fff">${fmt(d.perShare)}</b> • Members: ${d.membersPaid}</div><div style="max-height:300px;overflow-y:auto;margin-top:10px">${rows.map(r=>`<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #334155;font-size:13px"><span>${r.name} (${r.memberId}) — ${r.shares} share(s)</span><b style="color:#22c55e">${fmt(r.dividend)}</b></div>`).join('')}${(d.breakdown||[]).length>50?`<div style="color:#64748b;font-size:12px;padding:8px 0">... and ${d.breakdown.length-50} more</div>`:''}</div>`;
  document.getElementById('viewModal').style.display='grid';
}
function closeView(){ document.getElementById('viewModal').style.display='none'; }
function deleteDist(idx){
  let dists=getDists(); let d=dists[idx]; if(!d) return;
  if(!confirm('Delete this distribution?\n\n'+fmt(d.totalProfit)+' — '+new Date(d.date).toLocaleDateString('en-GB')+'\n\nThis does NOT remove the dividend transactions already added to Savings. Delete only the record.')) return;
  dists.splice(idx,1); setDists(dists); renderTop(); renderHistory(); alert('Deleted');
}
function openDistribute(){
  let totalShares=members.reduce((s,m)=>s+shareCount(m),0);
  if(!totalShares) return alert('No shares yet. Buy shares first in Members / Savings.');
  document.getElementById('distDate').value=new Date().toISOString().slice(0,10);
  document.getElementById('distModal').style.display='grid';
  updateDistPreview();
}
function closeDist(){ document.getElementById('distModal').style.display='none'; }
function updateDistPreview(){
  let profit=Number(document.getElementById('profitInput').value||0);
  let totalShares=members.reduce((s,m)=>s+shareCount(m),0);
  let perShare= totalShares ? profit/totalShares : 0;
  document.getElementById('distPreview').innerHTML=`Total Profit: <b>${fmt(profit)}</b><br>Total Shares: <b>${totalShares}</b><br>Per Share: <b style="color:#22c55e">${fmt(perShare)}</b><br>Shareholders: <b>${members.filter(m=>shareCount(m)>0).length}</b><br><span style="color:#94a3b8">Example: Member with 1 share gets ${fmt(perShare)} • 2 shares gets ${fmt(perShare*2)} • 5 shares gets ${fmt(perShare*5)}</span>`;
  let top=[...members].filter(m=>shareCount(m)>0).sort((a,b)=>shareCount(b)-shareCount(a)).slice(0,5);
  document.getElementById('distPreviewList').innerHTML=top.map(m=>`<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #334155;font-size:13px"><span>${cleanName(m.name||m.fullName)||('Member '+(m.member_no||m.id))} — ${shareCount(m)} share(s)</span><b style="color:#22c55e">${fmt(shareCount(m)*perShare)}</b></div>`).join('');
}
async function confirmDistribute(){
  let profit=Number(document.getElementById('profitInput').value||0);
  let date=document.getElementById('distDate').value || new Date().toISOString().slice(0,10);
  let note=document.getElementById('distNote').value.trim() || (new Date(date).getFullYear()+' Annual Dividends');
  if(!profit || profit<=0) return alert('Enter Total Profit > 0');
  let totalShares=members.reduce((s,m)=>s+shareCount(m),0);
  if(!totalShares) return alert('No shares');
  let perShare=profit/totalShares;
  let holders=members.filter(m=>shareCount(m)>0);
  if(!confirm('Distribute '+fmt(profit)+' to '+holders.length+' shareholders?\n\nPer Share: '+fmt(perShare)+'\nTotal Shares: '+totalShares+'\n\nThis will add a Dividend transaction to each member\'s Savings.')) return;
  let breakdown=[];
  let ok=0;
  for(let m of holders){
    let shares=shareCount(m);
    let div=Number((shares*perShare).toFixed(2));
    let mid=String(m.member_no||m.id);
    breakdown.push({memberId:mid, name:cleanName(m.name||m.fullName)||('Member '+mid), shares, dividend:div});
    try{
      let r=await fetch('/api/transaction',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({memberId:mid, member_no:mid, type:'dividend', amount:div, desc:'Dividend - '+note+' - '+shares+' share(s) × '+fmt(perShare), date:new Date(date).toISOString()})});
      if(r.ok) ok++;
    }catch(e){}
  }
  let dists=getDists();
  dists.push({date:new Date(date).toISOString(), note, totalProfit:profit, perShare, totalShares, membersPaid:ok, breakdown});
  setDists(dists);
  closeDist(); renderTop(); renderHistory();
  alert('✅ Dividends Distributed!\n\nTotal: '+fmt(profit)+'\nPer Share: '+fmt(perShare)+'\nMembers Paid: '+ok+' / '+holders.length);
}
function showEconomic(){
  let box=document.getElementById('economicBox');
  box.style.display= box.style.display==='none' ? 'block' : 'none';
  if(box.style.display==='block') renderEconomic();
}
function renderEconomic(){
  let q=(document.getElementById('econSearch').value||'').toLowerCase();
  let sort=document.getElementById('econSort').value;
  let totalShares=members.reduce((s,m)=>s+shareCount(m),0);
  let profit=10000; let perShare= totalShares ? profit/totalShares : 0;
  let list=members.filter(m=>shareCount(m)>0);
  if(q) list=list.filter(m=> (cleanName(m.name||m.fullName)||'').toLowerCase().includes(q) || String(m.member_no||m.id).toLowerCase().includes(q));
  if(sort==='shares-desc') list.sort((a,b)=>shareCount(b)-shareCount(a));
  else if(sort==='shares-asc') list.sort((a,b)=>shareCount(a)-shareCount(b));
  else list.sort((a,b)=> (cleanName(a.name||a.fullName)||'').localeCompare(cleanName(b.name||b.fullName)||''));
  document.getElementById('economicBody').innerHTML=list.map((m,i)=>{
    let shares=shareCount(m); let pct= totalShares ? (shares/totalShares*100) : 0;
    let mid=m.member_no||m.id;
    return `<tr><td>${i+1}</td><td><b>${cleanName(m.name||m.fullName)||('Member '+mid)}</b><div style="color:#64748b;font-size:12px">${mid}</div></td><td>${shares}</td><td>${fmt(shares*2000)}</td><td><div style="display:flex;align-items:center;gap:8px"><div style="flex:1;background:#0f172a;height:8px;border-radius:10px;overflow:hidden"><div style="width:${Math.min(100,pct)}%;background:#22c55e;height:100%"></div></div><span>${pct.toFixed(2)}%</span></div></td><td style="color:#22c55e;font-weight:700">${fmt(shares*perShare)}</td></tr>`;
  }).join('') || '<tr><td colspan="6" style="text-align:center;color:#94a3b8">No shareholders yet</td></tr>';
}
function updateBadges(){
  try{
    let loans=JSON.parse(localStorage.getItem('pendingLoans')||'[]').filter(x=>x.status==='pending').length;
    let late=JSON.parse(localStorage.getItem('latePayments')||'[]').filter(x=>x.status==='pending').length;
    let total=loans+late;
    let ml=document.getElementById('menuLoansBadge'); if(ml){ ml.style.display=total?'inline-block':'none'; ml.innerText=total; }
    let bell=document.getElementById('topBellCount'); if(bell){ bell.style.display=total?'block':'none'; bell.innerText=total; }
    let sav=JSON.parse(localStorage.getItem('pendingSavings')||'[]').filter(x=>x.status==='pending').length;
    let ms=document.getElementById('menuSavingsBadge'); if(ms){ ms.style.display=sav?'inline-block':'none'; ms.innerText=sav; }
  }catch(e){}
}
load();
</script>
</body></html>
