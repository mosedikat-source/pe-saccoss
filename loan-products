</div>

<div class="main">
<div class="topbar"><div><button class="hamburger" onclick="toggleMenu()">☰</button></div><div class="icons"><span onclick="location.href='settings.html'">🔧</span><span style="position:relative" onclick="location.href='loans.html'">🔔<span id="topBellCount" style="position:absolute;top:-8px;right:-8px;background:#7f1d1d;font-size:10px;padding:2px 5px;border-radius:10px;display:none">0</span></span></div></div>

<div class="header"><div><h1 style="font-size:28px;font-weight:800">Loan Products</h1><p style="color:#94a3b8;font-size:13px;margin-top:4px">Manage loan types and interest rates</p></div><div class="header-actions"><button class="btn" onclick="accrueInterest()">↻ Accrue Monthly Interest</button><button class="btn btn-green" onclick="openAdd()">+ Add Product</button></div></div>

<div class="box"><h3 style="margin-bottom:4px">All Products</h3><p style="color:#94a3b8;font-size:13px;margin-bottom:10px">Configure rates and terms for each loan type</p>
<div style="overflow-x:auto"><table><thead><tr><th>Product</th><th>Interest Rate</th><th>Method</th><th>Max Term</th><th>Status</th><th style="text-align:right">Actions</th></tr></thead><tbody id="productBody"></tbody></table></div>
<div id="productCount" style="color:#64748b;font-size:12px;margin-top:12px"></div>
</div>

<div class="box" style="margin-top:16px"><h3 style="margin-bottom:8px">ℹ️ How rates work</h3><div style="color:#94a3b8;font-size:13px;line-height:1.8">
- <b style="color:#fff">Normal loan:</b> 30% Flat — e.g. LSL 10,000 → Interest LSL 3,000 — Total LSL 13,000 / 60 months<br>
- <b style="color:#fff">Emergency above 2000:</b> 5% per month — Reducing Balance — max 3 months<br>
- <b style="color:#fff">Emergency ≤ 2000:</b> 5% Flat — 1 month — e.g. LSL 2,000 → Interest LSL 100<br>
- <b style="color:#fff">Loyalty:</b> 0.01% Flat — 24 months — almost free for loyal members<br>
- <b style="color:#fff">Revolving:</b> 20% Flat — 60 months — can borrow again after repaying<br>
- <b style="color:#fff">Shares:</b> 1 Share = LSL 2,000 — shown in Dashboard / Members
</div></div>
</div>

<div id="productModal" class="modal"><div class="modal-box">
<div style="display:flex;justify-content:space-between;align-items:center"><h3 id="modalTitle">+ Add Product</h3><span style="cursor:pointer;font-size:20px" onclick="closeModal()">×</span></div>
<label>Product Name *</label><input id="pName" placeholder="e.g. Normal loan">
<label>Interest Rate *</label><input id="pRate" type="number" step="0.01" placeholder="e.g. 30 for 30%">
<label>Rate Type</label><select id="pRateType"><option value="%">% - Percent</option><option value="%/mo">%/mo - Percent per month</option></select>
<label>Method *</label><select id="pMethod"><option>Flat</option><option>Reducing Balance</option></select>
<label>Max Term (months) *</label><input id="pTerm" type="number" placeholder="e.g. 60">
<label>Min Amount (LSL) - optional</label><input id="pMin" type="number" placeholder="e.g. 0">
<label>Max Amount (LSL) - optional</label><input id="pMax" type="number" placeholder="e.g. 50000">
<label>Description</label><textarea id="pDesc" rows="2" placeholder="e.g. For normal members..."></textarea>
<label>Status</label><select id="pStatus"><option value="Active">Active</option><option value="Inactive">Inactive</option></select>
<div id="previewBox" style="background:#0f172a;padding:12px;border-radius:10px;font-size:13px;line-height:1.7;margin-top:10px"></div>
<div style="display:flex;gap:10px;margin-top:14px"><button class="btn btn-green" style="flex:1" id="saveBtn" onclick="saveProduct()">Save Product</button><button class="btn" style="flex:1" onclick="closeModal()">Cancel</button></div>
</div></div>

<script>
function toggleMenu(){ document.getElementById('sidebar').classList.toggle('open'); document.getElementById('overlay').classList.toggle('show'); }
if(localStorage.getItem('pe_role')!=='admin'){ location.href='/index.html'; }
const DEFAULT_PRODUCTS=[
  {id:'normal', name:'Normal loan', rate:30, rateType:'%', method:'Flat', maxTerm:60, min:0, max:0, desc:'Normal loan for members', status:'Active'},
  {id:'emerg-above', name:'Emergency Loan above 2000.00', rate:5, rateType:'%/mo', method:'Reducing Balance', maxTerm:3, min:2001, max:0, desc:'Emergency above LSL 2000', status:'Active'},
  {id:'loyalty', name:'Loyalty benefits loan', rate:0.01, rateType:'%', method:'Flat', maxTerm:24, min:0, max:0, desc:'For loyal long-term members', status:'Active'},
  {id:'revolving', name:'Loan revolving', rate:20, rateType:'%', method:'Flat', maxTerm:60, min:0, max:0, desc:'Revolving - borrow again after repaying', status:'Active'},
  {id:'emerg-below', name:'Emergency loan Equal or Less than 2000.00', rate:5, rateType:'%', method:'Flat', maxTerm:1, min:0, max:2000, desc:'Emergency up to LSL 2000', status:'Active'},
];
function getProducts(){ try{ let p=JSON.parse(localStorage.getItem('loanProducts')||'null'); if(!p || !p.length){ localStorage.setItem('loanProducts', JSON.stringify(DEFAULT_PRODUCTS)); return [...DEFAULT_PRODUCTS]; } return p; }catch(e){ return [...DEFAULT_PRODUCTS]; } }
function saveProducts(p){ localStorage.setItem('loanProducts', JSON.stringify(p)); render(); updateBadges(); }
function updateBadges(){
  try{
    let loans=JSON.parse(localStorage.getItem('pendingLoans')||'[]').filter(x=>x.status==='pending').length;
    let late=JSON.parse(localStorage.getItem('latePayments')||'[]').filter(x=>x.status==='pending').length;
    let total=loans+late;
    let ml=document.getElementById('menuLoansBadge'); if(ml){ ml.style.display=total?'inline-block':'none'; ml.innerText=total; }
    let bell=document.getElementById('topBellCount'); if(bell){ bell.style.display=total?'block':'none'; bell.innerText=total; }
    let sav=JSON.parse(localStorage.getItem('pendingSavings')||'[]').filter(x=>x.status==='pending').length;
    let ms=document.getElementById('menuSavingsBadge'); if(ms){ ms.style.display=sav?'inline-block':'none'; ms.innerText=sav; }
  }catch(e){}
}
let editingId=null;
function render(){
  let list=getProducts();
  let body=document.getElementById('productBody');
  document.getElementById('productCount').innerText=list.length+' products • '+list.filter(x=>x.status==='Active').length+' active';
  body.innerHTML=list.map(p=>{
    let rateLabel = p.rate + (p.rateType||'%');
    let termLabel = p.maxTerm + (p.maxTerm===1?' month':' months');
    return `<tr><td><div style="display:flex;align-items:center;gap:10px"><span style="color:#64748b">📦</span><div><b>${p.name}</b>${p.desc?`<div style="color:#64748b;font-size:12px">${p.desc}</div>`:''}${p.min||p.max?`<div style="color:#64748b;font-size:11px">${p.min?'Min LSL '+Number(p.min).toLocaleString():''} ${p.max?'• Max LSL '+Number(p.max).toLocaleString():''}</div>`:''}</div></div></td><td><span class="rate-badge">${rateLabel}</span></td><td style="color:#94a3b8">${p.method}</td><td>${termLabel}</td><td><span class="status-badge ${p.status!=='Active'?'inactive':''}" onclick="toggleStatus('${p.id}')">${p.status}</span></td><td style="text-align:right"><button class="icon-btn" onclick="openEdit('${p.id}')" title="Edit">✏️</button><button class="icon-btn del" onclick="deleteProduct('${p.id}')" title="Delete">🗑️</button></td></tr>`;
  }).join('');
}
function toggleStatus(id){ let list=getProducts(); let p=list.find(x=>String(x.id)===String(id)); if(!p) return; p.status=p.status==='Active'?'Inactive':'Active'; saveProducts(list); }
function deleteProduct(id){ let list=getProducts(); let p=list.find(x=>String(x.id)===String(id)); if(!p) return; if(!confirm('Delete product "'+p.name+'"?\nThis will not delete existing loans.')) return; saveProducts(list.filter(x=>String(x.id)!==String(id))); }
function openAdd(){ editingId=null; document.getElementById('modalTitle').innerText='+ Add Product'; document.getElementById('saveBtn').innerText='Save Product'; ['pName','pRate','pTerm','pMin','pMax','pDesc'].forEach(id=>document.getElementById(id).value=''); document.getElementById('pRateType').value='%'; document.getElementById('pMethod').value='Flat'; document.getElementById('pStatus').value='Active'; updatePreview(); document.getElementById('productModal').style.display='grid'; }
function openEdit(id){ let p=getProducts().find(x=>String(x.id)===String(id)); if(!p) return; editingId=id; document.getElementById('modalTitle').innerText='Edit Product'; document.getElementById('saveBtn').innerText='Update Product'; document.getElementById('pName').value=p.name; document.getElementById('pRate').value=p.rate; document.getElementById('pRateType').value=p.rateType||'%'; document.getElementById('pMethod').value=p.method||'Flat'; document.getElementById('pTerm').value=p.maxTerm; document.getElementById('pMin').value=p.min||''; document.getElementById('pMax').value=p.max||''; document.getElementById('pDesc').value=p.desc||''; document.getElementById('pStatus').value=p.status||'Active'; updatePreview(); document.getElementById('productModal').style.display='grid'; }
function closeModal(){ document.getElementById('productModal').style.display='none'; }
function updatePreview(){
  let name=document.getElementById('pName').value||'New Product';
  let rate=Number(document.getElementById('pRate').value||0);
  let rateType=document.getElementById('pRateType').value;
  let method=document.getElementById('pMethod').value;
  let term=Number(document.getElementById('pTerm').value||0);
  let example=10000; let interest = rateType==='%/mo' ? example*rate/100*term : example*rate/100;
  document.getElementById('previewBox').innerHTML=`<b>Preview:</b> ${name} — ${rate}${rateType} — ${method} — ${term} months<br>Example: LSL 10,000 → Interest <b style="color:#22c55e">LSL ${interest.toLocaleString()}</b> → Total <b>LSL ${(example+interest).toLocaleString()}</b> → Monthly <b>LSL ${term?((example+interest)/term).toFixed(2):'0'}</b>`;
}
['pName','pRate','pRateType','pMethod','pTerm'].forEach(id=>document.getElementById(id).addEventListener('input', updatePreview));
document.getElementById('pRateType').addEventListener('change', updatePreview);
document.getElementById('pMethod').addEventListener('change', updatePreview);
function saveProduct(){
  let name=document.getElementById('pName').value.trim();
  let rate=Number(document.getElementById('pRate').value||0);
  let term=Number(document.getElementById('pTerm').value||0);
  if(!name) return alert('Enter Product Name');
  if(!rate && rate!==0) return alert('Enter Interest Rate');
  if(!term) return alert('Enter Max Term (months)');
  let list=getProducts();
  let data={name, rate, rateType:document.getElementById('pRateType').value, method:document.getElementById('pMethod').value, maxTerm:term, min:Number(document.getElementById('pMin').value||0), max:Number(document.getElementById('pMax').value||0), desc:document.getElementById('pDesc').value.trim(), status:document.getElementById('pStatus').value};
  if(editingId){ let idx=list.findIndex(x=>String(x.id)===String(editingId)); if(idx>=0){ list[idx]={...list[idx], ...data}; } } else { data.id='p-'+Date.now(); list.push(data); }
  saveProducts(list); closeModal(); alert('✅ Product saved: '+name);
}
async function accrueInterest(){
  if(!confirm('Accrue Monthly Interest for all active loans?\n\nThis will add interest for this month to all active loans based on their product rate.')) return;
  let products=getProducts();
  let res=await fetch('/api/transactions'); let td=await res.json(); let txs=Array.isArray(td)?td:td.transactions||[];
  let map={};
  txs.forEach(t=>{ let mid=String(t.memberId||t.member_no||''); let ty=(t.type||'').toLowerCase(); if(ty.includes('loan') && !ty.includes('repay')){ let lt=(t.loanType||'Emergency'); if(!map[mid+'|'+lt]) map[mid+'|'+lt]={memberId:mid, loanType:lt, principal:0, repaid:0}; map[mid+'|'+lt].principal+=Number(t.amount||0); } if(ty.includes('repay')){ let lt=(t.loanType||'Emergency'); let k=mid+'|'+lt; if(map[k]) map[k].repaid+=Number(t.amount||0); } });
  let count=0, totalInterest=0;
  for(let k in map){
    let v=map[k]; let outstanding=Math.max(0, v.principal - v.repaid); if(outstanding<=0) continue;
    let prod = products.find(p=> p.name.toLowerCase().includes(v.loanType.toLowerCase()) || v.loanType.toLowerCase().includes(p.name.toLowerCase().split(' ')[0]) ) || products.find(p=>p.name==='Normal loan');
    if(!prod || prod.status!=='Active') continue;
    let monthlyRate = prod.rateType==='%/mo' ? prod.rate/100 : (prod.rate/100)/ (prod.maxTerm||12);
    let interest = outstanding * monthlyRate;
    if(interest<=0) continue;
    try{
      let r=await fetch('/api/transaction',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({memberId:v.memberId, member_no:v.memberId, type:'interest_accrual', amount:Number(interest.toFixed(2)), loanType:v.loanType, desc:'Monthly Interest Accrual - '+prod.name+' - '+prod.rate+(prod.rateType||'%')+' - '+new Date().toLocaleDateString('en-GB',{month:'long',year:'numeric'}), date:new Date().toISOString()})});
      if(r.ok){ count++; totalInterest+=interest; }
    }catch(e){}
  }
  alert('✅ Accrued Monthly Interest\n\nMembers: '+count+'\nTotal Interest: LSL '+totalInterest.toFixed(2)+'\n\nCheck Loans / Reports - interest is now added.');
}
render(); updateBadges();
</script>
</body></html>
