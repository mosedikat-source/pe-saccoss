<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Loan Products - P.E. SACCOS LTD</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Inter,system-ui,Arial,sans-serif}
body{background:#0f172a;color:#fff;min-height:100vh;display:flex}
.sidebar{width:250px;background:#020617;padding:18px;flex-shrink:0;position:sticky;top:0;height:100vh;overflow:auto}
.brand{display:flex;align-items:center;gap:12px;margin-bottom:24px}
.brand-logo{width:42px;height:42px;flex-shrink:0}
.brand-name{font-weight:800;font-size:15px}.brand-email{color:#64748b;font-size:12px;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.badge-admin{background:#14532d;border:1px solid #22c55e;color:#22c55e;font-size:11px;padding:2px 8px;border-radius:20px;display:flex;align-items:center;gap:4px}
.menu-title{color:#475569;font-size:12px;margin:18px 0 8px;letter-spacing:.5px}
.menu-item{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:10px;color:#94a3b8;text-decoration:none;font-size:14px;cursor:pointer;position:relative}
.menu-item.active{background:#1e293b;color:#fff}
.menu-item:hover{background:#1a2332;color:#fff}
.menu-item .count{position:absolute;right:12px;background:#f59e0b;color:#000;font-size:11px;padding:2px 8px;border-radius:20px;font-weight:700}
.main{flex:1;padding:20px;overflow:auto;min-width:0}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.topbar .icons{display:flex;gap:16px;align-items:center;font-size:20px;cursor:pointer}
.header{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:18px}
.btn{padding:10px 16px;border-radius:10px;border:1px solid #334155;background:#1e293b;color:#fff;cursor:pointer;font-weight:600;font-size:13px}
.btn-green{background:#22c55e;color:#fff;border:none}
.box{background:#1e293b;border:1px solid #2d3a52;border-radius:14px;padding:22px}
table{width:100%;border-collapse:collapse;font-size:13px}
th{color:#94a3b8;text-align:left;padding:12px 10px;border-bottom:1px solid #334155;font-weight:500}
td{padding:16px 10px;border-bottom:1px solid #1e293b;vertical-align:middle}
.rate-badge{background:#14532d;color:#22c55e;padding:5px 10px;border-radius:20px;font-size:12px;font-weight:700;white-space:nowrap}
.status-badge{background:#14532d;color:#22c55e;padding:5px 12px;border-radius:20px;font-size:12px;font-weight:700;cursor:pointer;border:1px solid #22c55e;white-space:nowrap}
.status-badge.inactive{background:#422006;color:#f59e0b;border-color:#f59e0b}
.icon-btn{background:none;border:none;cursor:pointer;font-size:16px;padding:6px}
.icon-btn.del{color:#ef4444}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.7);display:none;place-items:center;z-index:1000;padding:12px}
.modal-box{background:#1e293b;border-radius:16px;padding:22px;width:92%;max-width:480px;max-height:92vh;overflow-y:auto}
input,select,textarea{width:100%;padding:10px;margin:6px 0;border-radius:10px;background:#0f172a;color:#fff;border:1px solid #334155;font-size:16px}
label{font-size:13px;color:#94a3b8}
.hamburger{display:none;background:#1e293b;border:1px solid #334155;color:#fff;font-size:22px;padding:6px 12px;border-radius:10px;cursor:pointer}
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:90}
.overlay.show{display:block}
.header-actions{display:flex;gap:8px;flex-wrap:wrap}
@media(max-width:900px){
  body{flex-direction:column}
  .hamburger{display:block}
  .sidebar{position:fixed;left:-280px;top:0;bottom:0;z-index:99;transition:left .3s;box-shadow:20px 0 40px rgba(0,0,0,.5);height:100dvh}
  .sidebar.open{left:0}
  .main{padding:14px;width:100%}
  table{font-size:12px}
  .header{flex-direction:column}
}
@media(max-width:520px){
  .box{padding:14px}
  .header h1{font-size:22px !important}
  .header-actions{flex-direction:column;width:100%}
  .header-actions .btn{width:100%}
  table{display:block;overflow-x:auto;white-space:nowrap}
}
</style></head><body>
<div id="overlay" class="overlay" onclick="toggleMenu()"></div>
<div id="sidebar" class="sidebar">
<div class="brand"><svg class="brand-logo" viewBox="0 0 100 100"><circle cx="50" cy="50" r="12" fill="#0f172a"/><g><circle cx="50" cy="12" r="8" fill="#f97316"/><path d="M35 35 Q50 28 65 35 L60 55 Q50 48 40 55 Z" fill="#f97316"/></g><g><circle cx="85" cy="32" r="8" fill="#3b82f6"/><path d="M70 45 Q80 30 88 35 L78 58 Q70 52 62 48 Z" fill="#3b82f6"/></g><g><circle cx="78" cy="72" r="8" fill="#a21caf"/><path d="M60 62 Q78 62 82 72 L60 82 Q58 72 52 66 Z" fill="#a21caf"/></g><g><circle cx="35" cy="82" r="8" fill="#22c55e"/><path d="M48 66 Q42 78 28 78 L35 58 Q45 60 52 62 Z" fill="#22c55e"/></g><g><circle cx="12" cy="38" r="8" fill="#f59e0b"/><path d="M28 42 Q18 35 15 28 L38 28 Q38 40 35 48 Z" fill="#f59e0b"/></g></svg><div><div class="brand-name">P. E. SACCOS LTD</div><div style="display:flex;gap:6px;align-items:center"><span class="brand-email">mosedikat@gm...</span><span class="badge-admin">🛡️ admin</span></div></div></div>
<div class="menu-title">Menu</div>
<a href="dashboard.html" class="menu-item">⊞ Dashboard</a>
<a href="staff-dashboard.html" class="menu-item">▦ Staff Dashboard</a>
<a href="members.html" class="menu-item">👥 Members</a>
<a href="savings.html" class="menu-item">🐷 Savings <span class="count" id="menuSavingsBadge" style="display:none">0</span></a>
<a href="loans.html" class="menu-item">🏦 Loans <span class="count" id="menuLoansBadge" style="display:none">0</span></a>
<a href="loan-products.html" class="menu-item active">📦 Loan Products</a>
<a href="loan-calculator.html" class="menu-item">🧮 Loan Calculator</a>
<a href="dividends.html" class="menu-item">💰 Dividends</a>
<a href="reports.html" class="menu-item">📄 Reports</a>
<div class="menu-title">System</div>
<a href="repayment-audit.html" class="menu-item">📋 Repayment Audit</a>
