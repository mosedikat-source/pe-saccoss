<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Inter,system-ui,Arial,sans-serif}
body{background:#0f172a;color:#fff;min-height:100vh;display:flex}
.sidebar{width:250px;background:#020617;padding:18px;flex-shrink:0;position:sticky;top:0;height:100vh;overflow:auto}
.brand{display:flex;align-items:center;gap:12px;margin-bottom:24px}
.brand-logo{width:42px;height:42px;flex-shrink:0}
.brand-name{font-weight:800;font-size:15px}.brand-email{color:#64748b;font-size:12px;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.badge-admin{background:#14532d;border:1px solid #22c55e;color:#22c55e;font-size:11px;padding:2px 8px;border-radius:20px;display:flex;align-items:center;gap:4px}
.menu-title{color:#475569;font-size:12px;margin:18px 0 8px;letter-spacing:.5px}
.menu-item{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:10px;color:#94a3b8;text-decoration:none;font-size:14px;cursor:pointer;position:relative}
.menu-item.active{background:#1e293b;color:#fff}
.menu-item:hover{background:#1a2332;color:#fff}
.menu-item .count{position:absolute;right:12px;background:#f59e0b;color:#000;font-size:11px;padding:2px 8px;border-radius:20px;font-weight:700}
.main{flex:1;padding:20px;overflow:auto;min-width:0}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.topbar .icons{display:flex;gap:16px;align-items:center;font-size:20px;cursor:pointer}
.box{background:#1e293b;border:1px solid #2d3a52;border-radius:14px;padding:22px;margin-bottom:16px}
.grid5{display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1fr;gap:12px;margin-top:14px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:16px}
label{font-size:13px;color:#fff;font-weight:600}
input,select{width:100%;padding:12px;border-radius:10px;background:#0f172a;color:#fff;border:1px solid #334155;margin-top:6px;font-size:16px}
.btn{padding:10px 16px;border-radius:10px;border:1px solid #334155;background:#0f172a;color:#fff;cursor:pointer;font-weight:600;font-size:13px}
.btn-green{background:#22c55e;color:#fff;border:none}
.btn-gold{background:#f59e0b;color:#000;border:none}
table{width:100%;border-collapse:collapse;font-size:13px}
th{color:#94a3b8;text-align:left;padding:12px 8px;border-bottom:1px solid #334155;font-weight:500}
td{padding:12px 8px;border-bottom:1px solid #1e293b}
.hamburger{display:none;background:#1e293b;border:1px solid #334155;color:#fff;font-size:22px;padding:6px 12px;border-radius:10px;cursor:pointer}
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:90}
.overlay.show{display:block}
.calc-actions{display:flex;gap:8px;margin-top:14px;flex-wrap:wrap}
@media(max-width:900px){
  body{flex-direction:column}
  .hamburger{display:block}
  .sidebar{position:fixed;left:-280px;top:0;bottom:0;z-index:99;transition:left .3s;box-shadow:20px 0 40px rgba(0,0,0,.5);height:100dvh}
  .sidebar.open{left:0}
  .main{padding:14px;width:100%}
  .grid5{grid-template-columns:1fr 1fr}
  .grid3{grid-template-columns:1fr}
}
@media(max-width:520px){
  .grid5{grid-template-columns:1fr}
  .box{padding:14px}
  .calc-actions{flex-direction:column}
  .calc-actions .btn{width:100%}
  table{display:block;overflow-x:auto;white-space:nowrap}
}
@media print{ .sidebar,.no-print,.hamburger,.overlay{display:none!important} body{background:#fff;color:#000} .main{padding:0} .box{background:#fff;color:#000;border:1px solid #ccc} }
</style></head><body>
