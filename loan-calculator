<div class="main">
<div class="topbar"><div><button class="hamburger" onclick="toggleMenu()">☰</button></div><div class="icons"><span onclick="location.href='settings.html'">🔧</span><span style="position:relative" onclick="location.href='loans.html'">🔔<span id="topBellCount" style="position:absolute;top:-8px;right:-8px;background:#7f1d1d;font-size:10px;padding:2px 5px;border-radius:10px;display:none">0</span></span></div></div>

<div style="display:flex;gap:10px;align-items:flex-start;margin-bottom:18px"><span style="font-size:28px">🧮</span><div><h1 style="font-size:28px;font-weight:800">Loan Calculator</h1><p style="color:#94a3b8;font-size:13px;margin-top:2px">Estimate your installments, interest and balance over time.</p></div></div>

<div class="box"><h3>Loan details</h3><p style="color:#94a3b8;font-size:13px;margin-top:4px">These figures are an estimate only.</p>
<div style="margin-top:14px"><label>Loan Product — select to auto-fill rate & term</label><select id="productSelect" onchange="applyProduct()"><option value="">Custom — type manually</option></select><div id="productHint" style="color:#64748b;font-size:12px;margin-top:4px"></div></div>
<div class="grid5">
<div><label>Principal (LSL)</label><input id="principal" type="number" value="5000" oninput="calc()"></div>
<div><label>Interest rate (% )</label><input id="rate" type="number" step="0.01" value="5" oninput="calc()"></div>
<div><label>Term (months)</label><input id="term" type="number" value="12" oninput="calc()"></div>
<div><label>First payment date</label><input id="firstDate" type="date" value="2026-11-20" onchange="calc()"></div>
<div><label>Interest method</label><select id="method" onchange="calc()"><option value="flat-once">Flat rate (once off)</option><option value="flat-month">Flat rate (per month)</option><option value="reducing">Reducing Balance</option></select></div>
</div>
<div class="calc-actions no-print"><button class="btn" onclick="clearAll()">↺ Clear</button><button class="btn btn-green" onclick="calc()">Calculate</button><button class="btn" onclick="window.print()">🖨️ Print Schedule</button><button class="btn btn-gold" onclick="applyToLoan()">🏦 Apply to Loan →</button></div>
<div id="methodHint" style="color:#64748b;font-size:12px;margin-top:10px"></div>
</div>

<div class="grid3">
<div class="box" style="margin:0"><div style="color:#94a3b8;font-size:13px">Monthly installment</div><div id="monthlyOut" style="font-size:22px;font-weight:800;margin-top:6px">LSL 437.50</div><div id="monthlyNote" style="color:#64748b;font-size:11px;margin-top:4px">Same every month (Flat)</div></div>
<div class="box" style="margin:0"><div style="color:#94a3b8;font-size:13px">Total interest</div><div id="interestOut" style="font-size:22px;font-weight:800;margin-top:6px">LSL 250.00</div><div id="interestNote" style="color:#64748b;font-size:11px;margin-top:4px">5,000 × 5% = 250</div></div>
<div class="box" style="margin:0"><div style="color:#94a3b8;font-size:13px">Total repayable</div><div id="totalOut" style="font-size:22px;font-weight:800;margin-top:6px">LSL 5,250.00</div><div id="totalNote" style="color:#64748b;font-size:11px;margin-top:4px">Principal + Interest</div></div>
</div>

<div class="box"><h3>Repayment schedule</h3><p id="scheduleTitle" style="color:#94a3b8;font-size:13px;margin-top:4px">12 payments, final payment on 10/20/2027</p>
<div style="overflow-x:auto;margin-top:10px"><table><thead><tr><th>#</th><th>Payment date</th><th style="text-align:right">Opening balance</th><th style="text-align:right">Interest</th><th style="text-align:right">Principal</th><th style="text-align:right">Installment</th><th style="text-align:right">Closing balance</th></tr></thead><tbody id="scheduleBody"></tbody></table></div>
<div style="display:flex;justify-content:space-between;margin-top:12px;font-size:13px;flex-wrap:wrap;gap:8px"><span style="color:#94a3b8">Total Principal: <b id="sumPrincipal" style="color:#fff">LSL 5,000.00</b></span><span style="color:#94a3b8">Total Interest: <b id="sumInterest" style="color:#fff">LSL 250.00</b></span><span style="color:#94a3b8">Total Paid: <b id="sumTotal" style="color:#fff">LSL 5,250.00</b></span></div>
</div>

<div class="box"><h3>How to use</h3><div style="color:#94a3b8;font-size:13px;line-height:1.8;margin-top:6px">
- <b style="color:#fff">Flat (once off):</b> Interest = Principal × Rate% once — e.g. Normal loan? No, Emergency ≤2000 uses this. Example in screenshot: 5,000 × 5% = 250<br>
- <b style="color:#fff">Flat (per month):</b> Interest = Principal × Rate% × Months — e.g. Emergency >2000 at 5%/mo for 3 months: 5,000 × 5% × 3 = 750<br>
- <b style="color:#fff">Reducing Balance:</b> Interest charged only on remaining balance — cheaper for member, interest drops each month<br>
- <b style="color:#fff">Your Products:</b> Normal 30% Flat / Emergency >2000 5%/mo Reducing / Loyalty 0.01% Flat / Revolving 20% Flat / Emergency ≤2000 5% Flat
</div></div>
</div>

<script>
function toggleMenu(){ document.getElementById('sidebar').classList.toggle('open'); document.getElementById('overlay').classList.toggle('show'); }
if(localStorage.getItem('pe_role')!=='admin'){ location.href='/index.html'; }
const DEFAULT_PRODUCTS=[
  {id:'normal', name:'Normal loan', rate:30, rateType:'%', method:'Flat', maxTerm:60},
  {id:'emerg-above', name:'Emergency Loan above 2000.00', rate:5, rateType:'%/mo', method:'Reducing Balance', maxTerm:3},
  {id:'loyalty', name:'Loyalty benefits loan', rate:0.01, rateType:'%', method:'Flat', maxTerm:24},
  {id:'revolving', name:'Loan revolving', rate:20, rateType:'%', method:'Flat', maxTerm:60},
  {id:'emerg-below', name:'Emergency loan Equal or Less than 2000.00', rate:5, rateType:'%', method:'Flat', maxTerm:1},
];
function getProducts(){ try{ let p=JSON.parse(localStorage.getItem('loanProducts')||'null'); if(!p||!p.length) return DEFAULT_PRODUCTS; return p; }catch(e){ return DEFAULT_PRODUCTS; } }
function fmt(n){ return 'LSL '+Number(n||0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function fmtShort(n){ return 'LSL '+Number(n||0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function loadProducts(){
  let sel=document.getElementById('productSelect');
  getProducts().forEach(p=>{
    let o=document.createElement('option'); o.value=p.id; o.textContent=p.name+' — '+p.rate+(p.rateType||'%')+' — '+p.method+' — '+p.maxTerm+' months'; sel.appendChild(o);
  });
  updateBadges();
}
function applyProduct(){
  let id=document.getElementById('productSelect').value;
  if(!id){ document.getElementById('productHint').innerText=''; return; }
  let p=getProducts().find(x=>String(x.id)===String(id)); if(!p) return;
  document.getElementById('rate').value=p.rate;
  document.getElementById('term').value=p.maxTerm;
  if(p.method==='Reducing Balance') document.getElementById('method').value='reducing';
  else if(p.rateType==='%/mo') document.getElementById('method').value='flat-month';
  else document.getElementById('method').value='flat-once';
  document.getElementById('productHint').innerText='✔ '+p.name+' — '+p.rate+(p.rateType||'%')+' — '+p.method+' — Max '+p.maxTerm+' months — auto-filled. Change Principal to test.';
  calc();
}
function addMonths(date, n){
  let d=new Date(date); d.setMonth(d.getMonth()+n); return d;
}
function fmtDateUS(d){ return (d.getMonth()+1)+'/'+d.getDate()+'/'+d.getFullYear(); }
function calc(){
  let P=Number(document.getElementById('principal').value||0);
  let rate=Number(document.getElementById('rate').value||0);
  let term=Number(document.getElementById('term').value||0);
  let method=document.getElementById('method').value;
  let first=document.getElementById('firstDate').value || '2026-11-20';
  if(!P || !term){ return; }
  let schedule=[]; let totalInterest=0; let monthly=0;
  if(method==='flat-once'){
    totalInterest = P * rate/100;
    let monthlyInterest = totalInterest/term;
    let monthlyPrincipal = P/term;
    monthly = monthlyPrincipal + monthlyInterest;
    document.getElementById('methodHint').innerText='Flat (once off): Interest = '+P.toLocaleString()+' × '+rate+'% = '+fmt(totalInterest)+' once. Split equally over '+term+' months.';
    document.getElementById('monthlyNote').innerText='Same every month (Flat)';
    document.getElementById('interestNote').innerText=P.toLocaleString()+' × '+rate+'% = '+totalInterest.toFixed(2);
    let bal=P;
    for(let i=1;i<=term;i++){
      let open=bal; let interest=monthlyInterest; let prin=monthlyPrincipal; let inst=monthly; bal=Math.max(0, bal-prin);
      if(i===term){ prin=open; inst=prin+interest; bal=0; }
      schedule.push({i, date:addMonths(first,i), open, interest, prin, inst, close:bal});
    }
  } else if(method==='flat-month'){
    totalInterest = P * rate/100 * term;
    let monthlyInterest = P * rate/100;
    let monthlyPrincipal = P/term;
    monthly = monthlyPrincipal + monthlyInterest;
    document.getElementById('methodHint').innerText='Flat (per month): Interest per month = '+P.toLocaleString()+' × '+rate+'% = '+fmt(monthlyInterest)+' × '+term+' months = '+fmt(totalInterest);
    document.getElementById('monthlyNote').innerText='Same every month (Flat per month)';
    document.getElementById('interestNote').innerText=P.toLocaleString()+' × '+rate+'% × '+term+' = '+totalInterest.toFixed(2);
    let bal=P;
    for(let i=1;i<=term;i++){
      let open=bal; let interest=monthlyInterest; let prin=monthlyPrincipal; let inst=monthly; bal=Math.max(0, bal-prin);
      if(i===term){ prin=open; inst=prin+interest; bal=0; }
      schedule.push({i, date:addMonths(first,i), open, interest, prin, inst, close:bal});
    }
  } else {
    let r=rate/100;
    if(r===0){ monthly=P/term; } else { monthly = P * r * Math.pow(1+r,term) / (Math.pow(1+r,term)-1); }
    document.getElementById('methodHint').innerText='Reducing Balance: Interest charged only on remaining balance — interest drops each month. Monthly rate = '+rate+'%';
    document.getElementById('monthlyNote').innerText='Reducing Balance — interest drops each month';
    let bal=P;
    for(let i=1;i<=term;i++){
      let open=bal; let interest=open*r; let prin=monthly-interest; let inst=monthly;
      if(i===term){ prin=open; inst=prin+interest; bal=0; } else { bal=open-prin; }
      schedule.push({i, date:addMonths(first,i), open, interest, prin, inst, close:bal});
      totalInterest+=interest;
    }
    document.getElementById('interestNote').innerText='Sum of monthly interest on reducing balance';
  }
  let total = P + totalInterest;
  document.getElementById('monthlyOut').innerText=fmtShort(monthly);
  document.getElementById('interestOut').innerText=fmtShort(totalInterest);
  document.getElementById('totalOut').innerText=fmtShort(total);
  document.getElementById('totalNote').innerText='Principal + Interest';
  let last=schedule[schedule.length-1];
  document.getElementById('scheduleTitle').innerText=term+' payments, final payment on '+fmtDateUS(last.date);
  document.getElementById('scheduleBody').innerHTML=schedule.map(s=>`<tr><td>${s.i}</td><td>${fmtDateUS(s.date)}</td><td style="text-align:right">${fmt(s.open)}</td><td style="text-align:right">${fmt(s.interest)}</td><td style="text-align:right">${fmt(s.prin)}</td><td style="text-align:right">${fmt(s.inst)}</td><td style="text-align:right">${fmt(s.close)}</td></tr>`).join('');
  let sumP=schedule.reduce((a,s)=>a+s.prin,0); let sumI=schedule.reduce((a,s)=>a+s.interest,0);
  document.getElementById('sumPrincipal').innerText=fmt(sumP);
  document.getElementById('sumInterest').innerText=fmt(sumI);
  document.getElementById('sumTotal').innerText=fmt(sumP+sumI);
  localStorage.setItem('calc_last', JSON.stringify({principal:P, rate, term, method, monthly, totalInterest, total, product:document.getElementById('productSelect').value}));
}
function clearAll(){
  document.getElementById('principal').value=''; document.getElementById('rate').value=''; document.getElementById('term').value='';
  document.getElementById('productSelect').value=''; document.getElementById('productHint').innerText='';
  document.getElementById('monthlyOut').innerText='LSL 0.00'; document.getElementById('interestOut').innerText='LSL 0.00'; document.getElementById('totalOut').innerText='LSL 0.00';
  document.getElementById('scheduleBody').innerHTML=''; document.getElementById('scheduleTitle').innerText='Enter loan details to see schedule';
}
function applyToLoan(){
  let c=JSON.parse(localStorage.getItem('calc_last')||'{}');
  if(!c.principal) return alert('Calculate first');
  localStorage.setItem('apply_loan_amount', String(c.principal));
  localStorage.setItem('apply_loan_product', c.product||'');
  localStorage.setItem('apply_loan_term', String(c.term||''));
  location.href='loans.html';
}
function updateBadges(){
  try{
    let loans=JSON.parse(localStorage.getItem('pendingLoans')||'[]').filter(x=>x.status==='pending').length;
    let late=JSON.parse(localStorage.getItem('latePayments')||'[]').filter(x=>x.status==='pending').length;
    let total=loans+late;
    let ml=document.getElementById('menuLoansBadge'); if(ml){ ml.style.display=total?'inline-block':'none'; ml.innerText=total; }
    let bell=document.getElementById('topBellCount'); if(bell){ bell.style.display=total?'block':'none'; bell.innerText=total; }
    let sav=JSON.parse(localStorage.getItem('pendingSavings')||'[]').filter(x=>x.status==='pending').length;
    let ms=document.getElementById('menuSavingsBadge'); if(ms){ ms.style.display=sav?'inline-block':'none'; ms.innerText=sav; }
  }catch(e){}
}
loadProducts(); calc();
</script>
